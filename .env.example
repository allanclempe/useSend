# The dev database is Neon Local (docker/dev/compose.yml), a proxy to a real
# Neon branch. `neon:npg` is the fixed local credential pair - the proxy swaps
# in the real branch credentials. Keep the quotes: the bare `&` in a query
# string backgrounds the assignment in a shell-sourced env file.
DATABASE_URL="postgres://neon:npg@localhost:54320/neondb?sslmode=require"

# Neon Local needs these to open the proxy. Get them from the Neon console:
# project settings for the ID, an API key under account settings, and the
# branch you want dev to run against.
NEON_PROJECT_ID=""
NEON_API_KEY=""
NEON_BRANCH_ID=""

REDIS_URL="redis://localhost:6379"



NEXTAUTH_URL="http://localhost:3000"

SMTP_HOST=smtp.mailtrap.io  # Example SMTP host
SMTP_USER=test_userdadad@example.com  # Example SMTP user


AWS_DEFAULT_REGION="us-east-1"
AWS_ACCESS_KEY_ID="some-access-key"
AWS_SECRET_ACCESS_KEY="some-secret-key"
AWS_SES_ENDPOINT="http://localhost:3003/api/ses"
AWS_SNS_ENDPOINT="http://localhost:3003/api/sns"

NEXTAUTH_SECRET=""

# Signs the better-auth session cookie. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Optional: better-auth infers its base URL from the request when unset.
# BETTER_AUTH_URL="http://localhost:3000"

FROM_EMAIL="hello@usesend.com"

API_RATE_LIMIT=2
AUTH_EMAIL_RATE_LIMIT=5

# Optional: prefix all Redis keys (useful for shared Redis with ACL isolation)
# REDIS_KEY_PREFIX=""

NEXT_PUBLIC_IS_CLOUD=true
