# The dev database is Neon Local (docker/dev/compose.yml), a proxy to a real
# Neon branch. `neon:npg` is the fixed local credential pair - the proxy swaps
# in the real branch credentials. Keep the quotes: the bare `&` in a query
# string backgrounds the assignment in a shell-sourced env file.
DATABASE_URL="postgres://neon:npg@localhost:54320/neondb?sslmode=require"

# Neon Local needs these to open the proxy. Get them from the Neon console:
# project settings for the ID, an API key under account settings, and the
# branch you want dev to run against.
NEON_PROJECT_ID=""
NEON_API_KEY=""
NEON_BRANCH_ID=""

# The public URL the app is served from. Every absolute link we generate hangs
# off it, including better-auth's base URL.
APP_URL="http://localhost:3000"

SMTP_HOST=smtp.mailtrap.io  # Example SMTP host
SMTP_USER=test_userdadad@example.com  # Example SMTP user


AWS_DEFAULT_REGION="us-east-1"
AWS_ACCESS_KEY_ID="some-access-key"
AWS_SECRET_ACCESS_KEY="some-secret-key"
# The local SES/SNS simulator from docker/dev/compose.yml, published on 5350.
# Unset means real AWS, which `src/env.js` refuses outside production -- see
# apps/web/.dev.vars.example, which is the file the Worker actually reads.
AWS_SES_ENDPOINT="http://localhost:5350/api/ses"
AWS_SNS_ENDPOINT="http://localhost:5350/api/sns"

# Where that simulator posts SES notifications: the dev server's
# /api/ses_callback. Only docker compose reads it, to build WEBHOOK_URL. The
# default is 8788, the port `pnpm dev` listens on; set it if yours differs.
# USESEND_DEV_PORT=8788

# Keys the hashes in unsubscribe, one-click-unsubscribe and double-opt-in links,
# and signs upload URLs. Generate the first one with:
#   openssl rand -base64 32
#
# Never rotate it once mail has gone out: the hash is baked into every
# unsubscribe link already delivered, and a new value invalidates all of them.
APP_SECRET=""

# Signs the better-auth session cookie. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Keys the HMAC that hashes API keys. Required -- the app will not boot without
# it, deliberately: a default would be a hardcoded key that verifies every API
# key everywhere it was left unset. Generate one with:
#   openssl rand -hex 32
# Rotating it invalidates every existing API key.
API_KEY_HMAC_SECRET=""

FROM_EMAIL="hello@usesend.com"

API_RATE_LIMIT=2
AUTH_EMAIL_RATE_LIMIT=5

NEXT_PUBLIC_IS_CLOUD=true
