        "max_batch_timeout": 1,
        "max_retries": 2,
        "max_concurrency": 20,
        "dead_letter_queue": "usesend-dead-letter"
      },
      {
        "queue": "usesend-eu-west-2-transaction",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "max_concurrency": 20,
        "dead_letter_queue": "usesend-dead-letter"
      },
      {
        "queue": "usesend-eu-west-2-marketing",
