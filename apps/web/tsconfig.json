{
  "extends": "@usesend/typescript-config/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "noEmit": true,
    // Vite compiles JSX with its own transform, so `react-jsx` is what the
    // editor and `tsc --noEmit` should see. It was `preserve` while Next.js
    // was in the tree only because `next dev` rewrote it on every start.
    "jsx": "react-jsx",
    // `base.json` turns declaration emit on for publishable packages. Nothing
    // consumes types from this app, and with `noEmit` the files are never
    // written -- but TypeScript still enforces that every inferred exported
    // type is nameable from the importer, which fails for types reaching into
    // a transitive dependency pnpm keeps out of this app's node_modules.
    "declaration": false,
    "declarationMap": false,
    "strictNullChecks": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.js",
    ".eslintrc.cjs"
  ],
  "exclude": [
    "node_modules",
    ".wrangler",
    "dist"
  ]
}
