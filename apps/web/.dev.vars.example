# Local values for `pnpm dev:worker`. Copy to `.dev.vars`, which is gitignored.
#
# Under `nodejs_compat` these are read back through `process.env`, which is what
# lets `src/env.js` validate inside a Worker exactly as it does under Node.
#
# DATABASE_URL is only a fallback: when the Hyperdrive binding is present the
# Worker uses its connection string instead. It still has to be set and valid,
# because `src/env.js` validates it at module load.
#
# NEXT_PUBLIC_* does NOT belong here, and setting it here does nothing useful.
# Those are inlined into the browser bundle at build time, and this file is read
# by `wrangler` at runtime inside the Worker, where the browser cannot see it --
# so a value set here applied to the server half only, and the two halves of the
# same page disagreed about whether this was a cloud install (#9). They come
# from the repo-root `.env`, which Vite reads for both bundles.

DATABASE_URL="postgresql://usesend:password@127.0.0.1:54329/usesend_test"
APP_URL="http://localhost:8788"
APP_SECRET="cf-local-dev-secret"
NODE_ENV="development"
AWS_ACCESS_KEY_ID="local"
AWS_SECRET_ACCESS_KEY="local"
AWS_DEFAULT_REGION="us-east-1"

# Keys the HMAC that hashes API keys (#48). Required -- `src/env.js` refuses to
# validate without it, so the isolate fails at startup rather than at request
# time. Generate a throwaway one for local dev with:
#   openssl rand -hex 32
API_KEY_HMAC_SECRET=""

# Signs the session cookie and keys the hash that sign-in codes are stored
# under. `src/env.js` only requires it in production, and better-auth falls
# back to a well-known constant without it -- which is fine for a throwaway
# local database and wrong everywhere else. Set it here so local behaviour
# matches a deploy. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Turns on email sign-in. `getEnabledAuthProviders()` reads it as a boolean --
# with no value, and no GitHub or Google credentials either, the login page
# renders with no way to sign in at all, which is a confusing first five
# minutes. In development `sendSignUpEmail` logs the code instead of sending
# it, so any address will do.
FROM_EMAIL="hello@localhost.test"
