{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "DATABASE_URL",
        "APP_URL",
        "GITHUB_ID",
        "GITHUB_SECRET",
        "AWS_SECRET_KEY",
        "AWS_ACCESS_KEY",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_ACCESS_KEY_ID",
        "AWS_DEFAULT_REGION",
        "AWS_SES_ENDPOINT",
        "AWS_SNS_ENDPOINT",
        "APP_SECRET",
        "BETTER_AUTH_SECRET",
        "API_KEY_HMAC_SECRET",
        "NODE_ENV",
        "LOG_LEVEL",
        "OTEL_SERVICE_NAME",
        "OTEL_SERVICE_VERSION",
        "VERCEL_URL",
        "VERCEL",
        "SKIP_ENV_VALIDATION",
        "PORT",
        "UNSEND_API_KEY",
        "USESEND_API_KEY",
        "REDIS_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "NEXT_PUBLIC_IS_CLOUD",
        "EMAIL_CLEANUP_DAYS",
        "EMAIL_EVENT_RETENTION_DAYS",
        "WEBHOOK_CALL_RETENTION_DAYS"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
